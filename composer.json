{
  "name": "devcote/pathfinder_esiphp8",
  "description": "ESI API library for Pathfinder",
  "type": "library",
  "homepage": "https://github.com/devcote/pathfinder_esi_php8",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "devcote",
      "email": "defcote@gmail.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "lock": false
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/devcote/pathfinder_esi_php8"
    }
  ],
  "autoload": {
    "psr-4": {
      "Exodus4D\\ESI\\": "app/"
    }
  },
  "require": {
    "php": "8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.10",
    "caseyamcl/guzzle_retry_middleware": "^2.13",
    "symfony/cache": "^6.4"
  }
}
